<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>1.0.0</Version>
        <PackageId>Bannerlord.PrivateWars.Module</PackageId>
        <IsPackable>false</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Platforms>x64</Platforms>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <BuildForWindows>true</BuildForWindows>
        <BuildForWindowsStore>true</BuildForWindowsStore>
        <ModuleId>$(MSBuildProjectName)</ModuleId>
        <ModuleName>$(MSBuildProjectName)</ModuleName>

        <!-- only for SubModule.xml -->
        <HarmonyVersion>2.4.2</HarmonyVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.104" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="Harmony.DependencyInjection" Version="0.2.0"/>

        <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Sandbox" Version="$(GameVersion).*-*" PrivateAssets="All"/>
        <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="$(GameVersion).*-*" PrivateAssets="All"/>

        <!-- Compile-time only: the DLL is provided at runtime by the Bannerlord.UIExtenderEx module -->
        <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.2" IncludeAssets="compile" PrivateAssets="all"/>

        <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="2.1.0" />

        <ProjectReference Include="..\Bannerlord.PrivateWars.Domain\Bannerlord.PrivateWars.Domain.csproj"/>
    </ItemGroup>

    <Target Name="Copy module binaries to wEditor" AfterTargets="CopyBinariesWindows"
            Condition="$(BuildForWindows) == 'true' AND $(ModuleId) != '' AND Exists($(GameFolder))">
        <CreateDirectory Directory="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_wEditor" ContinueOnError="WarnAndContinue" />

        <CopyFolder FromDirectory="$(TargetDir)"
                    ToDirectory="$(GameFolder)/Modules/$(ModuleId)/bin/Win64_Shipping_wEditor"
                    Regex="$(PostBuildCopyToModulesRegex)"
                    Clean="true"
                    ContinueOnError="WarnAndContinue" />
    </Target>

</Project>
